/*
  Security headers for the KKA Client Portal when served by Cloudflare Pages.
  Keep the policy conservative because the portal loads authenticated modules
  and Supabase/OneDrive integrations.
*/
/*
  Global defaults
*/
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://esm.sh; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https://*.supabase.co https://*.supabase.in https://auth.ca-kka.com https://graph.microsoft.com https://login.microsoftonline.com; frame-src 'self' https://login.microsoftonline.com https://*.supabase.co; worker-src 'self' blob:; media-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://accounts.google.com; frame-ancestors 'none'

/index.html
  Cache-Control: no-store, max-age=0
  X-Robots-Tag: noindex, nofollow, noarchive

/*.html
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
